#!/usr/bin/php
<?php
declare(strict_types=1);
require_once '/usr/local/emhttp/plugins/unmotion/include/lib.php';
try{
    $action=$argv[1]??'';$uuid=$argv[2]??'';
    if(!preg_match('/^[a-f0-9-]{36}$/i',$uuid))throw new RuntimeException('Invalid state VM UUID.');
    $xml=unmDomainXml($uuid,true);
    if($action==='tpm'){echo unmTpmStatePath($uuid,$xml,($argv[3]??'required')==='required');exit;}
    if($action==='nvram'){
        $vm=unmParseVm($uuid);$vm['nvram']=unmMigrationNvramXml($xml);
        echo unmOwnedNvram($vm)['source'];exit;
    }
    if($action==='evidence'){
        if(unmRecoveryVmState($uuid)!=='shut off')throw new RuntimeException('State evidence requires a powered-off VM.');
        $vm=unmParseVm($uuid);$evidence=[];$nvram=unmOwnedNvram($vm);
        if($nvram['kind']!=='none')$evidence[]=unmHostStateEvidence($nvram['source'],'nvram',$uuid);
        $tpm=unmTpmStatePath($uuid,$xml);
        if($tpm!=='')$evidence[]=unmHostStateEvidence($tpm,'tpm',$uuid);
        unmAtomicJson($argv[3],['vmUuid'=>$uuid,'state'=>$evidence]);exit;
    }
    throw new RuntimeException('Unknown host-state action.');
}catch(Throwable $e){fwrite(STDERR,'Host state: '.$e->getMessage()."\n");exit(30);}
