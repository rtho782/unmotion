declare(strict_types=1);
require '/usr/local/emhttp/plugins/unmotion/include/lib.php';
require_once '/usr/local/emhttp/plugins/unmotion/include/live-migration.php';
try{
    if(posix_geteuid()!==0)throw new RuntimeException('Root is required.');umask(0077);
    $mode=$argv[1]??'';$id=unmLiveId($argv[2]??'');$job=unmLiveJob($id);$runtime=unmLiveRuntime($id);
    if(!unmLiveAlive($job))throw new RuntimeException('Live migration session is inactive.');
    if($mode==='relay'){unmLiveRelay($id,$argv[3]??'');exit;}
    if($mode==='client'){
        if($job['role']!=='source')throw new RuntimeException('Wrong control direction.');$peer=unmLivePeerForJob($job);$token=trim((string)file_get_contents($runtime.'/token'));
        $args=unmLiveSshArgs($peer,['jobId'=>$id,'token'=>$token],'live-control');$p=proc_open($args,[0=>STDIN,1=>STDOUT,2=>STDERR],$pipes);if(!$p)throw new RuntimeException('Cannot open control transport.');exit(proc_close($p));
    }
    if($job['role']!=='destination')throw new RuntimeException('Wrong server direction.');
    if($mode==='benchmark'){
        $lock=fopen($runtime.'/benchmark.lock','c');if(!$lock||!flock($lock,LOCK_EX|LOCK_NB))throw new RuntimeException('Bandwidth measurement already active.');
        unmLiveNativeRun($job,null,null,true);exit;
    }
    if(!in_array($mode,['control','data'],true))throw new RuntimeException('Invalid stream operation.');
    if($mode==='control'){$lock=fopen($runtime.'/control.lock','c');if(!$lock||!flock($lock,LOCK_EX|LOCK_NB))throw new RuntimeException('Migration channel is already in use.');}
    else{[$lock,$progressChannel]=unmLiveDataLock($job,$runtime,$argv[3]??'');}
    if($mode==='control'){
        if(file_exists($runtime.'/control-consumed'))throw new RuntimeException('The single-use migration control session has been consumed.');
        $backend=stream_socket_client('unix:///var/run/libvirt/libvirt-sock',$error,$text,5);if(!$backend)throw new RuntimeException('Local libvirt is unavailable.');
        $guard=new UnmLiveRpcGuard($job,static function($kind,$value)use($id){unmLiveLog($id,'RPC '.$kind.' '.json_encode($value));},static function()use($job,$runtime){
            $r=unmLiveNativeRecord(UNM_BOOT_DIR,$job['vmUuid']);$state=unmLiveVmState($job['vmUuid']);if(($r['jobId']??'')!==$job['id']||($r['state']??'')!=='RECEIVING'||$state['state']!=='undefined'||!$state['qemuAbsent'])throw new RuntimeException('Incoming live VM ownership/conflict check failed.');
            $f=fopen($runtime.'/control-consumed','x');if(!$f)throw new RuntimeException('Migration control prepare was already consumed.');fclose($f);
        },static function(array $domain)use($job):void{unmLiveReceiveComplete($job);});
        unmLiveRpcProxy(STDIN,STDOUT,$backend,$guard,static fn()=>unmLiveAlive($job));fclose($backend);
    }elseif($mode==='data'){
        $channel=$argv[3]??'';$path=$runtime.'/'.$channel.'.sock';if(!in_array($channel,['memory','disk'],true)||is_link($path)||!file_exists($path)||filetype($path)!=='socket')throw new RuntimeException('Incoming data socket is unavailable.');
        $backend=stream_socket_client('unix://'.$path,$error,$text,5);if(!$backend)throw new RuntimeException('Incoming data socket is unavailable.');
        $progressFailed=false;$prior=unmLoadJson($runtime.'/received-'.$progressChannel.'.json')['bytes']??0;if(!is_int($prior)||$prior<0)$prior=0;
        unmLiveNativeRun($job,$backend,static function($bytes)use($runtime,$progressChannel,$prior,&$progressFailed){if(!$progressFailed&&$bytes<=PHP_INT_MAX-$prior)$progressFailed=!unmLiveObserveReceived($runtime,$progressChannel,$prior+$bytes);});fclose($backend);
    }else throw new RuntimeException('Unknown live I/O operation.');
}catch(Throwable $e){if(isset($id)&&preg_match('/\Alive-[a-f0-9]{24}\z/D',$id))unmLiveLog($id,'Transport rejected: '.$e->getMessage());fwrite(STDERR,'unMotion live transport: '.$e->getMessage()."\n");exit(1);}
