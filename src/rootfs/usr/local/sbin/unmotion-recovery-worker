#!/usr/bin/php
<?php
declare(strict_types=1);

require_once '/usr/local/emhttp/plugins/unmotion/include/lib.php';

$replicationId=(string)($argv[1]??'');
$operationId=(string)($argv[2]??'');
try{
    if(!preg_match('/^[A-Za-z0-9_.-]{8,80}$/',$replicationId))throw new InvalidArgumentException('Invalid recovery policy id.');
    unmRecoveryRunWorker($replicationId,$operationId);
    exit(0);
}catch(Throwable $e){
    fwrite(STDERR,gmdate('c').' '.$e->getMessage()."\n");
    exit(1);
}
