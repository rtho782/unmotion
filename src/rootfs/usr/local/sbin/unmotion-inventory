declare(strict_types=1);
require_once '/usr/local/emhttp/plugins/unmotion/include/lib.php';
try {
    if (($argv[1]??'')==='refresh' && count($argv)===2) unmInventoryCollect();
    elseif (($argv[1]??'')==='invalidate' && count($argv)===2) unmInventoryCache()->invalidate();
    else throw new InvalidArgumentException('Usage: unmotion-inventory refresh|invalidate');
} catch (Throwable $e) {fwrite(STDERR,$e->getMessage()."\n");exit(1);}
