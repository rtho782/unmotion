<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "unmotion">
<!ENTITY author "Richard Skinner">
<!ENTITY version "2026.11.14.03-0.5.2">
<!ENTITY launch "UnMotion">
<!ENTITY plgdir "/boot/config/plugins/&name;">
<!ENTITY package "&plgdir;/packages/unmotion-0.5.2_stable-noarch-1.txz">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="https://raw.githubusercontent.com/rtho782/unmotion/plugin-stable/unmotion.plg" launch="&launch;" min="7.3.2" icon="exchange" support="https://github.com/rtho782/unmotion/issues">
<CHANGES>
### unMotion 0.5.2
- A completed live destination becomes a normal VM without reboot or a separate hand-back. Successful moves automatically clean up the exact obsolete source disks/NVRAM/TPM after transfer sessions close; blocked cleanup is reported separately, with old-copy start fences/history retained. Failed or unresolved transfers retain their data.
- Permit same-vendor masked guests to move to an older physical CPU generation only after fresh complete guest CPU/nested validation. Repeat validation at receiver reservation; no physical-family ranking substitutes for compatibility proof.
- Native OpenSSH/libvirt live migration without a custom payload relay, RPC inspector or extra application-controlled pause. Both peers must enable administrator-equivalent native migration trust. Disposable source-bound keys, persistent start fences and authenticated ownership reconciliation remain; this is not a per-path sandbox.
- Settings selects AES-128-GCM (default) or AES-256-GCM for outgoing paired-host SSH connections, including Cold/Warm Move and replication. Cipher performance depends on the hosts and workload; no plaintext or silent fallback is offered.
- Explicitly review and reclaim proven inactive live-migration copies on the non-owner host. Exact per-object identity, fresh paired ownership callbacks, short owner leases and retryable deletion receipts protect active data; native start fences and job history remain.
- Older zvol GUID records can prove individual volumes. Unrecorded legacy file/TPM/NVRAM identities remain protected instead of being adopted by filename. No recursive cleanup is introduced; new successful jobs use the exact automatic cleanup described above.
- Require a durable successful native finish receipt bound to the exact receiver boot, QEMU process and storage/XML contract before committing an uncommitted receiver. Paused state or received-byte counters alone do not prove transfer completion.
- Experimental native software-TPM 2.0 live migration with fresh matching swtpm/libtpms checks, independent job/UUID-scoped destination state, exact native start fencing and retained source/partial state. No shared storage is required. Encrypted/custom-profile TPM backends remain excluded.
- Live migration supports one to sixteen independent raw/qcow2 file disks or whole raw ZFS volumes, including mixed guests. Zvols remain zvols, with independent job-owned destinations and full reservations; unrelated block devices and attached ISOs remain excluded.
- Fresh ZFS GUID/geometry and kernel device-lifetime checks protect zvol ownership. Capacity checks combine file/zvol budgets on shared destination pools, include allocation overhead and 20% free-space headroom, and preserve the destination dedup policy.
- Display disk-copy and RAM pre-copy/convergence statistics separately; retransmitted bytes are not an overall completion percentage or a promised ETA.
- Review live readiness even when a VM is ineligible. Show independent CPU, TPM, storage, device and network blockers; submission stays disabled until fresh preflight passes, and Start rechecks both hosts.
- Record source-side replica point counts from acknowledged destination inventory, including retention pruning, without treating display evidence as recovery authority.
- Preserve protocol 7. Live capability 4 requires matching 0.5.2 peers and native-data capability 1; retained-copy cleanup separately requires liveCleanupVersion 1. Ordinary supported Cold/Warm Move, clone, replication and retirement workflows retain their capability gates.
- Preserve CPU defaults, reviewed BIOS/UEFI firmware, nested Intel validation, paused receivers, durable ownership and explicit reconciliation. AMD nested live migration, passthrough and automatic failover remain excluded. Recovery arming after normal completion follows the separate recovery prerequisites.
- New successful live moves automatically remove verified obsolete source disks, NVRAM and TPM after sessions close. Failed/unresolved copies and blocked cleanup retain their data. No shared-storage service is introduced.
- Requires Unraid 7.3.2 or later. Package downloads are SHA-256 pinned; the verified current TXZ is retained for offline boots. Author: Richard Skinner.
</CHANGES>
<FILE Run="/usr/bin/php"><INLINE><![CDATA[<?php
declare(strict_types=1);

// PIDs, including process-group IDs, are reusable. Never use a saved PID as
// authority to signal a process: bind it to this boot, start tick and command.
function unmProcessSnapshot(int $pid, string $procRoot='/proc'): ?array {
    if($pid<2)return null;
    $base=rtrim($procRoot,'/').'/'.$pid;
    $boot=trim((string)@file_get_contents(rtrim($procRoot,'/').'/sys/kernel/random/boot_id'));
    $stat=(string)@file_get_contents($base.'/stat');
    $end=strrpos($stat,')');
    if(!preg_match('/^[a-f0-9-]{36}$/i',$boot)||$end===false||!str_starts_with($stat,$pid.' ('))return null;
    // comm may itself contain spaces and parentheses; fields begin after its LAST ')'.
    $fields=preg_split('/\s+/',trim(substr($stat,$end+1)));
    if(count($fields)<20||in_array($fields[0],['Z','X','x'],true))return null;
    foreach([1,2,3,19] as $index)if(!ctype_digit($fields[$index]))return null;
    $command=(string)@file_get_contents($base.'/cmdline');
    clearstatcache(true,$base.'/exe');
    $executable=@readlink($base.'/exe');$exeStat=@stat($base.'/exe');
    if($command===''||$executable===false||$exeStat===false)return null;
    $arguments=explode("\0",rtrim($command,"\0"));
    $result=['schema'=>1,'pid'=>$pid,'bootId'=>$boot,'startTicks'=>$fields[19],
        'parentPid'=>(int)$fields[1],'processGroup'=>(int)$fields[2],'session'=>(int)$fields[3],
        'executable'=>$executable,'executableDevice'=>(string)$exeStat['dev'],
        'executableInode'=>(string)$exeStat['ino'],'argv'=>$arguments];
    // Detect exit/exec/reuse while collecting the /proc fields.
    $again=(string)@file_get_contents($base.'/stat');$againEnd=strrpos($again,')');
    $againFields=$againEnd===false?[]:preg_split('/\s+/',trim(substr($again,$againEnd+1)));
    if(($againFields[19]??null)!==$fields[19]||in_array($againFields[0]??'',['Z','X','x'],true)
        ||(string)@file_get_contents($base.'/cmdline')!==$command||@readlink($base.'/exe')!==$executable)return null;
    return $result;
}

function unmProcessCommandMatches(array $snapshot,string $script,array $arguments=[]): bool {
    $argv=$snapshot['argv']??[];
    if(!is_array($argv)||!$argv||$script===''||$script[0]!=='/')return false;
    $offset=0;
    if(($argv[0]??'')!==$script){
        // Only recognise an actual interpreter executable, never a script name
        // occurring later in arbitrary argv (e.g. echo/sleep/php -r bait).
        if(!preg_match('/^(bash|php(?:[0-9]+(?:\.[0-9]+)?)?)$/',basename((string)($snapshot['executable']??'')))
            ||($argv[1]??'')!==$script)return false;
        $offset=1;
    }elseif((string)($snapshot['executable']??'')!==$script)return false;
    return array_slice($argv,$offset+1,count($arguments))===$arguments;
}

function unmProcessIdentityMatches(array $identity,string $procRoot='/proc'): bool {
    if(($identity['schema']??null)!==1||!is_int($identity['pid']??null))return false;
    $current=unmProcessSnapshot($identity['pid'],$procRoot);
    if($current===null)return false;
    // Parent PID may legitimately change after the short-lived launcher exits.
    foreach(['pid','bootId','startTicks','processGroup','session','executable','executableDevice','executableInode','argv'] as $key){
        if(!array_key_exists($key,$identity)||$identity[$key]!==$current[$key])return false;
    }
    return true;
}

function unmProcessReadIdentity(string $path,int $pid,string $script,array $arguments=[]): ?array {
    $identity=json_decode((string)@file_get_contents($path),true);
    if(!is_array($identity)||($identity['pid']??null)!==$pid
        ||!unmProcessCommandMatches($identity,$script,$arguments)||!unmProcessIdentityMatches($identity))return null;
    return $identity;
}

function unmProcessRecordedWorker(string $path,string $script,array $arguments=[]): ?array {
    $record=json_decode((string)@file_get_contents($path),true);
    if(!is_array($record))return null;
    return unmProcessReadIdentity($path,(int)($record['pid']??0),$script,$arguments);
}

function unmProcessCleanupCandidate(string $path,int $legacyPid,string $script,array $arguments=[]): ?array {
    $identity=unmProcessRecordedWorker($path,$script,$arguments);
    if($identity!==null)return $identity;
    $record=json_decode((string)@file_get_contents($path),true);
    foreach(array_unique([$legacyPid,(int)($record['pid']??0)]) as $pid){
        $current=unmProcessSnapshot($pid);
        if($current!==null&&unmProcessCommandMatches($current,$script,$arguments)){
            throw new RuntimeException('An active worker has no verifiable lifetime record. Let it finish before removing unMotion: '.$script);
        }
    }
    return null;
}

function unmProcessLegacyServiceAllowed(string $script,array $arguments): bool {
    return ($script==='/usr/local/sbin/unmotion-replication-scheduler'&&$arguments===[])
        ||($script==='/usr/local/sbin/unmotion-replication-lifecycle'&&$arguments===['--daemon']);
}

function unmProcessAdoptLegacyService(string $path,int $pid,string $script,array $arguments): ?array {
    // One-time 0.4.1 upgrade path for the TWO known singleton daemons only.
    // Never replace an existing lifetime record or adopt jobs/seed workers.
    if(file_exists($path)||is_link($path)||!unmProcessLegacyServiceAllowed($script,$arguments))return null;
    $current=unmProcessSnapshot($pid);
    if($current===null||!unmProcessCommandMatches($current,$script,$arguments))return null;
    $offset=($current['argv'][0]??'')===$script?0:1;
    if(array_slice($current['argv'],$offset+1)!==$arguments)return null;
    // Persist exactly the first observed lifetime; if it changed, the caller's
    // mandatory second identity check refuses the stop. No fresh PID fallback.
    $handle=@fopen($path,'x');if($handle===false)return null;
    try{
        if(!chmod($path,0600)||fwrite($handle,json_encode($current,JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR)."\n")===false)throw new RuntimeException('Unable to persist adopted service identity.');
    }finally{fclose($handle);}
    return unmProcessReadIdentity($path,$pid,$script,$arguments);
}

function unmProcessRegister(string $path,int $pid,string $script,array $arguments=[]): array {
    $identity=unmProcessSnapshot($pid);
    if($identity===null||!unmProcessCommandMatches($identity,$script,$arguments))throw new RuntimeException('Unable to prove worker process identity.');
    $temporary=$path.'.tmp.'.getmypid();
    $json=json_encode($identity,JSON_UNESCAPED_SLASHES|JSON_PRETTY_PRINT|JSON_THROW_ON_ERROR)."\n";
    if(file_put_contents($temporary,$json,LOCK_EX)===false||!chmod($temporary,0600)||!rename($temporary,$path)){
        @unlink($temporary);throw new RuntimeException('Unable to persist worker process identity.');
    }
    return $identity;
}

function unmProcessTree(array $identity): array {
    if(!unmProcessIdentityMatches($identity))return [];
    $candidates=[];
    foreach(glob('/proc/[0-9]*/stat')?:[] as $path){
        $candidate=unmProcessSnapshot((int)basename(dirname($path)));
        if($candidate!==null&&$candidate['session']===$identity['session']&&$candidate['processGroup']===$identity['processGroup'])$candidates[$candidate['pid']]=$candidate;
    }
    if(!unmProcessIdentityMatches($identity))return [];
    $owned=[$identity['pid']=>$identity];
    do{
        $changed=false;
        foreach($candidates as $pid=>$candidate){
            if(!isset($owned[$pid])&&isset($owned[$candidate['parentPid']])){$owned[$pid]=$candidate;$changed=true;}
        }
    }while($changed);
    // Stop children before the shell so its traps can reap and restore state.
    return array_reverse(array_values($owned));
}

function unmProcessSignal(array $identity,int $signal): bool {
    if(!in_array($signal,[15,9],true))throw new InvalidArgumentException('Unsupported process signal.');
    if(!function_exists('posix_kill'))throw new RuntimeException('PHP POSIX support is required for verified process signalling.');
    // Revalidate immediately before EVERY signal, including escalation. Never
    // use kill(-pgid) or pkill: those can hit new/unverified group members.
    if(!unmProcessIdentityMatches($identity))return false;
    return posix_kill($identity['pid'],$signal);
}

function unmProcessSignalTree(array $identity,int $signal): array {
    $members=unmProcessTree($identity);
    foreach($members as $member)unmProcessSignal($member,$signal);
    return $members;
}

function unmProcessStop(array $identity,int $graceMilliseconds=10000,bool $escalate=false): bool {
    $members=unmProcessSignalTree($identity,15);
    $deadline=microtime(true)+$graceMilliseconds/1000;
    do{
        $alive=array_values(array_filter($members,'unmProcessIdentityMatches'));
        if(!$alive)return true;
        usleep(100000);
    }while(microtime(true)<$deadline);
    if($escalate){
        // Keep the ORIGINAL identities, not freshly captured identities for the
        // old PID numbers. A replacement process must never inherit authority.
        foreach($alive as $member)unmProcessSignal($member,9);
        for($attempt=0;$attempt<20;$attempt++){
            if(!array_filter($members,'unmProcessIdentityMatches'))return true;
            usleep(100000);
        }
    }
    return !array_filter($members,'unmProcessIdentityMatches');
}

function unmProcessUpgradeInventory(): array {
    $workers=[];$daemons=[];
    $scripts=['unmotion-worker','unmotion-clone-worker','unmotion-seed-worker','unmotion-replication-worker','unmotion-recovery-worker','unmotion-soak-cleanup','unmotion-replication-scheduler','unmotion-replication-lifecycle',
        // Incoming receivers have no local migration job. The forced-command
        // gate remains alive while its rsync/ZFS child streams; agents and the
        // destination-start helper also cover legacy/in-flight remote calls.
        'unmotion-ssh-gate','unmotion-agent','unmotion-start-destination','unmotion-inventory','unmotion-live-worker','unmotion-live-progress','unmotion-live-io','unmotion-live-stream','unmotion-live-key-gate','unmotion-live-native-gate','unmotion-live-client','unmotion-live-ordinary','unmotion-live-cleanup-worker','unmotion-live-finish','unmotion-cpu-editor','unmotion-retire-worker','unmotion-seed-cleanup'];
    foreach(glob('/proc/[0-9]*/stat')?:[] as $path){
        $identity=unmProcessSnapshot((int)basename(dirname($path)));if($identity===null)continue;
        foreach($scripts as $name){
            $script='/usr/local/sbin/'.$name;
            if(!unmProcessCommandMatches($identity,$script))continue;
            $offset=($identity['argv'][0]??'')===$script?0:1;$arguments=array_slice($identity['argv'],$offset+1);
            if(unmProcessLegacyServiceAllowed($script,$arguments))$daemons[]=$identity;
            else $workers[]=$identity;
            break;
        }
    }
    return ['workers'=>$workers,'daemons'=>$daemons];
}

/** Complete local-only native-hook dependency set, pinned from the target package. */
function unmProcessFencePaths(): array {
    $base='/usr/local/emhttp/plugins/unmotion/include/';
    return array_merge(['/etc/libvirt/hooks/qemu.d/50-unmotion-recovery'],array_map(static fn($p)=>$base.$p,['native-fence.php','live-native-fence.php','live-firmware.php','live-storage.php','live-zvol-native.php','live-tpm.php','xml-canonical.php']));
}
function unmProcessFenceCompatible(array $target): array {
    $paths=unmProcessFencePaths();$keys=array_keys($target);sort($paths);sort($keys);
    if($paths!==$keys)throw new RuntimeException('The update has no complete compatible native-fence contract; stop live-owned VMs before this fencing-code upgrade.');
    $installed=[];foreach($target as $path=>$sha){if(!is_string($sha)||!preg_match('/\A[a-f0-9]{64}\z/D',$sha)||is_link($path)||!is_file($path))throw new RuntimeException('Native fencing code changes or differs locally; stop live-owned VMs before upgrading. No running VM was adopted.');$installed[$path]=(string)hash_file('sha256',$path);}
    $same=static function(array $a,array $b):bool{ksort($a);ksort($b);return $a===$b;};
    if($same($installed,$target))return $installed;
    // A transition is pinned at BOTH ends. Leaving an old allowlist in a future
    // build cannot silently bless that future build's changed native helper.
    $transitions=function_exists('unmProcessTargetFenceTransitions')?unmProcessTargetFenceTransitions():[];
    foreach($transitions as $t)if(is_array($t)&&is_array($t['from']??null)&&is_array($t['to']??null)&&$same($t['to'],$target)&&$same($t['from'],$installed))return $installed;
    throw new RuntimeException('Native fencing code changes or differs locally; stop live-owned VMs before upgrading. No running VM was adopted.');
}
function unmProcessLiveOwnerUpgradeable(array $r,array $q,array $target,string $run='/run/unmotion/lifecycle'): void {
    if(($r['state']??'')!=='OWNER'||($r['workflow']??'')==='ordinary-pending')throw new RuntimeException('Only a settled live owner can remain running during an update.');
    $installed=unmProcessFenceCompatible($target);
    $read=static function(string $p):array{if(is_link($p)||!is_file($p))throw new RuntimeException('Existing native VM admission/proof is missing; update refused without adopting the running VM.');$r=json_decode((string)file_get_contents($p),true);if(!is_array($r))throw new RuntimeException('Existing native VM admission/proof is corrupt.');return $r;};
    $boot=trim((string)file_get_contents('/proc/sys/kernel/random/boot_id'));
    $proof=$read($run.'/native-hook-proof.json');$daemon=$proof['daemon']??[];$p=unmProcessSnapshot((int)($daemon['pid']??0));
    $base='/usr/local/emhttp/plugins/unmotion/include/';$hash='';foreach(['live-native-fence.php','live-firmware.php','live-storage.php','live-zvol-native.php','live-tpm.php','xml-canonical.php'] as $file)$hash.=$installed[$base.$file];
    if(!$p||!in_array($p['executable'],['/usr/sbin/libvirtd','/usr/sbin/virtqemud','/usr/bin/libvirtd','/usr/bin/virtqemud'],true)||basename((string)($p['argv'][0]??''))!==basename($p['executable'])||($daemon['bootId']??'')!==$boot||($daemon['startTicks']??'')!==$p['startTicks']||($daemon['exe']??'')!==$p['executable']||($proof['hookSha256']??'')!==$installed['/etc/libvirt/hooks/qemu.d/50-unmotion-recovery']||($proof['helperSha256']??'')!==$installed[$base.'native-fence.php']||($proof['liveHelperSha256']??'')!==hash('sha256',$hash))throw new RuntimeException('The installed native fence is not proven active for this libvirt process; update refused.');
    $uuid=$r['vmUuid'];$a=$read($run.'/live-admissions/'.$uuid.'.json');$at=array_search('-uuid',$q['argv'],true);$name=$r['vmName']??'';
    $compact=['pid'=>$q['pid'],'startTicks'=>$q['startTicks'],'exe'=>$q['executable'],'bootId'=>$q['bootId'],'uuid'=>$uuid];
    if(!is_string($name)||$name===''||str_contains($name,'/')||str_contains($name,"\0")||$at===false||strtolower((string)($q['argv'][$at+1]??''))!==$uuid||$q['bootId']!==$boot||!str_starts_with(basename($q['executable']),'qemu-system-')||trim((string)@file_get_contents('/run/libvirt/qemu/'.$name.'.pid'))!==(string)$q['pid']||($a['jobId']??'')!==$r['jobId']||($a['bootId']??'')!==$boot||($a['phase']??'')!=='RUNNING'||($a['qemu']??null)!==$compact||!unmProcessIdentityMatches($q))throw new RuntimeException('The running live owner does not match its existing native admission; update refused without adopting or restarting it.');
}

function unmProcessPreinstall(): void {
    if(!function_exists('posix_kill'))throw new RuntimeException('PHP POSIX support is required for safe unMotion service upgrades.');
    $bootRestore=unmProcessEarlyBootRestore();
    $installed=@file_get_contents('/usr/local/emhttp/plugins/unmotion/include/lib.php');
    $installedProtocol=is_string($installed)&&preg_match('/const\s+UNM_PROTOCOL\s*=\s*(\d+)\s*;/',$installed,$match)?(int)$match[1]:0;
    // Do not break fencing restoration at boot or prevent an already-protocol-7
    // host from installing cleanup fixes. Legacy entries still cannot mutate.
    if(!$bootRestore&&$installedProtocol!==7)unmProcessAssertPreparedCompatible('/boot/config/plugins/unmotion',7);
    $fenceFiles=function_exists('unmProcessTargetFenceFiles')?unmProcessTargetFenceFiles():[];
    unmProcessAssertManagedGuestsStopped('/boot/config/plugins/unmotion',$bootRestore,$fenceFiles);
    if($bootRestore)echo "unMotion: restoring plugin during verified early boot, before VM Manager or QEMU. Durable recovery authority remains fenced.\n";
    $inventory=unmProcessUpgradeInventory();
    if($inventory['workers'])throw new RuntimeException('An unMotion migration, prepared-copy, replication, recovery, incoming transfer, remote request or delayed-cleanup worker is active. Let it finish or cancel it, then retry the upgrade. Do not start new operations while upgrading. No package or pairing settings have been changed.');
    // Use fresh exact /proc identities, never old PID files or the old rc stop
    // implementation. Preserve fencing hooks and all durable recovery state.
    foreach($inventory['daemons'] as $identity){
        if(!unmProcessStop($identity,10000))throw new RuntimeException('An exact unMotion runtime daemon did not stop. Upgrade refused. Inspect the runtime and retry; stopped daemons will restart on a successful installation or host boot.');
    }
    // A scheduler could launch a job between the first inventory and its stop.
    // Never terminate that worker or replace its scripts/transport underneath it.
    $remaining=unmProcessUpgradeInventory();
    if($remaining['workers']||$remaining['daemons'])throw new RuntimeException('An unMotion worker or daemon appeared while stopping scheduling. Upgrade refused; let active work finish and retry. Stopped runtime daemons restart on successful installation or host boot.');
    unmProcessAssertManagedGuestsStopped('/boot/config/plugins/unmotion',$bootRestore,$fenceFiles);
    echo "unMotion upgrade guard: no active workers; verified scheduling/lifecycle daemons stopped. Do not start new operations until installation completes.\n";
}

/** Standalone: also embedded in the readable PLG before installed code changes. */
function unmProcessAssertPreparedCompatible(string $base,int $targetProtocol): void {
    foreach(glob($base.'/seeds/*/seed.json')?:[] as $path){
        $seed=json_decode((string)file_get_contents($path),true);
        if(!is_array($seed))throw new RuntimeException('A corrupt prepared-copy record prevents safe protocol upgrade.');
        if(($seed['state']??'')==='REMOVED')continue;
        $hasData=!empty($seed['storage'])||!empty($seed['storageStarted'])||!empty($seed['baseSnapshot'])||!empty($seed['pendingSnapshot'])||!empty($seed['generation']);
        if(!$hasData)continue;
        $capsPath=dirname($path).'/remote-capabilities.json';$caps=is_file($capsPath)?json_decode((string)file_get_contents($capsPath),true):[];
        $protocol=(int)($seed['protocolVersion']??$caps['protocolVersion']??0);
        if($protocol!==$targetProtocol)throw new RuntimeException('Prepared/partial Warm Move '.basename(dirname($path)).' has legacy or unproven protocol ownership. Finish/remove it on compatible old peers before upgrading; already-upgraded legacy copies need ownership review. No cleanup was attempted.');
    }
}

// Compatible settled owners keep their existing admission. Never adopt a QEMU.
function unmProcessAssertManagedGuestsStopped(string $base='/boot/config/plugins/unmotion',bool $verifiedEarlyBoot=false,array $fenceFiles=[]): void {
    $liveManaged=[];
    foreach(array_unique(array_merge(glob($base.'/live-managed/*.json')?:[],glob($base.'/live-authority/*.json')?:[])) as $candidate){
        $path=$base.'/live-managed/'.basename($candidate);
        $m=json_decode((string)@file_get_contents($path),true);$uuid=(string)($m['vmUuid']??'');$r=json_decode((string)@file_get_contents($base.'/live-authority/'.$uuid.'.json'),true);
        if(is_link($path)||is_link($candidate)||!preg_match('/\A[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}\z/D',$uuid)||basename($path)!==$uuid.'.json'||($m['schemaVersion']??null)!==1||($r['schemaVersion']??null)!==1||($r['vmUuid']??'')!==$uuid||!preg_match('/\Alive-[a-f0-9]{24}\z/D',(string)($m['jobId']??''))||($r['jobId']??'')!==$m['jobId']||!in_array($r['state']??'',['OWNER','MOVING','RECEIVING','RETIRED','ABORTED'],true))throw new RuntimeException('Corrupt live migration authority prevents upgrade.');
        $host=trim((string)@file_get_contents($base.'/host_id'));$pattern='/\A[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}\z/D';
        if(isset($r['workflow'])&&!in_array($r['workflow'],['ordinary','ordinary-pending'],true)||($r['workflow']??'')==='ordinary-pending'&&(($r['state']??'')!=='OWNER'||!preg_match('/\A[a-f0-9]{32}\z/D',(string)($r['handbackNonce']??''))))throw new RuntimeException('Corrupt ordinary hand-back authority prevents upgrade.');
        if(!$verifiedEarlyBoot&&($r['workflow']??'')==='ordinary-pending')throw new RuntimeException('Finish the pending ordinary hand-back before upgrading.');
        if(!in_array($r['role']??'',['source','destination'],true)||!preg_match($pattern,(string)($r['sourceHostId']??''))||!preg_match($pattern,(string)($r['destinationHostId']??''))||$r['sourceHostId']===$r['destinationHostId']||($r[$r['role'].'HostId']??'')!==$host||!preg_match($pattern,(string)($r['bootId']??''))||!is_int($r['expiresAt']??null)||!in_array($r['state'],$r['role']==='source'?['OWNER','MOVING','RETIRED']:['OWNER','RECEIVING','ABORTED'],true))throw new RuntimeException('Live authority host/role is invalid; upgrade refused.');
        if(!$verifiedEarlyBoot&&in_array($r['state'],['MOVING','RECEIVING'],true))throw new RuntimeException('Reconcile unfinished live migration '.$m['jobId'].' before upgrading.');$liveManaged[$uuid]=$r;
    }
